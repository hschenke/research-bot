# ==============================================================================
# Research-Bot Umgebungsvariablen (Vorlage - NIEMALS echte Keys hier eintragen!)
# Kopiere diese Datei lokal nach `.env`
# ==============================================================================

# 1. Google Gemini API (Pflicht für KI-Recherche: https://aistudio.google.com/)
# Modelle werden dynamisch über den GEMINI_API_KEY abgerufen (Standard: gemini-3.5-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here


# 2. E-Mail-Benachrichtigung bei Fertigstellung (Resend empfohlen oder SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_TO=deine_email@beispiel.de
EMAIL_FROM="Research Bot <onboarding@resend.dev>"

# Alternativ: Klassischer SMTP-Versand (wenn EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 3. Cloud-Datenbank Turso LibSQL (Pflicht für verteilten Cloud-Betrieb Streamlit <-> GitHub Actions)
# Ohne Angabe nutzt der Bot lokal automatisch SQLite unter `data/research_bot.db`
TURSO_URL=libsql://deine-datenbank.turso.io
TURSO_KEY=your_turso_auth_token_here

# 4. Hintergrund-Worker (> 1h Läufe via GitHub Actions)
# WORKER_MODE: auto | github | local
WORKER_MODE=auto
GITHUB_TOKEN=your_github_pat_with_actions_write_scope
GITHUB_REPO=hschenke/research-bot
GITHUB_BRANCH=main
GITHUB_WORKFLOW_FILE=run_research.yaml

# 5. Web-App Zugriffsschutz & URL (für signierte Direkt-Links in E-Mails)
APP_PASSWORD=
STREAMLIT_APP_URL=https://research-bot.streamlit.app
