# Streamlit Community Cloud Secrets (Vorlage)
# Kopiere diesen Inhalt in Streamlit Cloud unter: App Settings -> Secrets

GEMINI_API_KEY = "dein_gemini_api_key_hier"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_DEEP_MODEL = "gemini-3.5-flash-lite"

# Zugriffsschutz für das Starten neuer Recherchen & Einstellungen
APP_PASSWORD = "dein_sicheres_passwort_hier"
STREAMLIT_APP_URL = "https://deine-research-bot-url.streamlit.app"

# Turso Cloud-Datenbank (verbindet Web-App und GitHub Actions Worker)
TURSO_URL = "libsql://deine-db.turso.io"
TURSO_KEY = "dein_turso_token_hier"

# GitHub Actions Hintergrund-Worker (für > 1h Recherche-Jobs unabhängig vom Browser)
WORKER_MODE = "auto"
GITHUB_TOKEN = "ghp_dein_fine_grained_token_mit_actions_read_write"
GITHUB_REPO = "hschenke/research-bot"
GITHUB_BRANCH = "main"

# Optional: E-Mail-Versand direkt aus der Web-App (für "Erneut per E-Mail senden")
EMAIL_PROVIDER = "resend"
RESEND_API_KEY = "re_dein_resend_key_hier"
EMAIL_TO = "deine_email@beispiel.de"
EMAIL_FROM = "Research Bot <onboarding@resend.dev>"
